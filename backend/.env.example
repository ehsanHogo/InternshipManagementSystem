APP_PORT=8083
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:4200
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=internship_management
DB_SSLMODE=disable
# Optional in APP_ENV=development (uses a dev default). Required in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_HOURS=24
UPLOAD_DIR=uploads
